{
  "realm": "cueai",
  "enabled": true,
  "displayName": "CueAI",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "internationalizationEnabled": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "user", "description": "Default CueAI user" },
      { "name": "admin", "description": "CueAI admin" }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "cueai-android",
      "name": "CueAI Android / Mobile SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "+"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    }
  ],
  "users": [
    {
      "username": "demo@cueai.dev",
      "email": "demo@cueai.dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "Demo1234!",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}
