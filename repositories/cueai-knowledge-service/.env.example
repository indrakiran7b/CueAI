# Used when this package is loaded by cueai-web (not a standalone container).
# Semantic RAG needs QDRANT_URL plus an embedding provider key.
# Without QDRANT_URL the existing keyword RAG fallback is used.

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cueai_knowledge
QDRANT_API_KEY=

# RAG_ENABLED=true
# RAG_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
