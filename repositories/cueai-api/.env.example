# Copy to .env in this directory for local development (never commit .env).

CUEAI_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Required in production. Empty/placeholder is allowed only in development.
AUTH_SECRET=

# Production (gitignored .env only):
# CUEAI_ENV=production
# AUTH_SECRET=<unique secret>
# CUEAI_BOOTSTRAP_ADMIN_ENABLED=false
# Or a custom bootstrap admin (never the documented local pair):
# CUEAI_BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=<your-admin@example.com>
# BOOTSTRAP_ADMIN_PASSWORD=<unique password>

# Local development only. Production must leave this unset/false
# unless a custom (non-default) bootstrap pair is set.
# CUEAI_BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional store directory. Docker compose sets /app/.data.
# CUEAI_DATA_DIR=

# Comma-separated browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis (required). Host: localhost. Compose network: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Live answer (FastAPI). Groq is primary; Gemini is the retryable-error fallback.
# GROQ_TIMEOUT_SECONDS=12
# GROQ_CONNECT_TIMEOUT_SECONDS=4
# GEMINI_TIMEOUT_SECONDS=14
# Leave keys empty until a development key is added to a gitignored .env.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL (optional — migration deferred; omit to skip DB startup and health check)
# DATABASE_URL=postgresql+asyncpg://cueai:cueai@localhost:5432/cueai

# --- Keygate (server-side only — NEVER ship to Electron/React) ---
# Desktop → CueAI API → Keygate. Do not put KEYGATE_SERVER_API_KEY / KEYGATE_API_KEY in desktop env.
# KEYGATE_BASE_URL=https://your-keygate.example.com
# KEYGATE_SERVER_API_KEY=kg_live_...
# KEYGATE_API_KEY=kg_live_...
# KEYGATE_PRODUCT_ID=
# KEYGATE_PUBLIC_KEY=
