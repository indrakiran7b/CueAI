# Copy to .env.local and fill in values
# Never commit real secrets.

AUTH_SECRET=

# Product environment. production|prod refuses placeholder AUTH_SECRET,
# default bootstrap credentials, and NEXT_PUBLIC_* auth bypass flags.
# Cookie Secure flag follows CUEAI_ENV, not NODE_ENV (images always use NODE_ENV=production).
# CUEAI_ENV=development
#
# Production (gitignored .env only):
# CUEAI_ENV=production
# AUTH_SECRET=<unique secret>
# CUEAI_BOOTSTRAP_ADMIN_ENABLED=false
# Or a custom bootstrap admin (never the documented local pair):
# CUEAI_BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=<your-admin@example.com>
# BOOTSTRAP_ADMIN_PASSWORD=<unique password>

# Local development only. Production must leave this unset/false.
# CUEAI_BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Optional dedicated vault key for BYOK / encrypted secrets (64-char hex or passphrase).
# Falls back to AUTH_SECRET-derived key when unset.
# CUEAI_SECRET_ENCRYPTION_KEY=

# Optional: proxy /api/auth/*, /api/workspaces, /api/onboarding to FastAPI (apps/api).
# CUEAI_USE_FASTAPI=1
# CUEAI_API_URL=http://127.0.0.1:8000
# Canonical origin for billing and non-OAuth links. Google OAuth redirect_uri
# follows the browser Host header (localhost vs 127.0.0.1) instead of this value.
AUTH_URL=http://127.0.0.1:3000

# Optional public URL when sharing via ngrok (update whenever the tunnel URL changes):
# NEXT_PUBLIC_APP_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# AUTH_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# NGROK_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Google OAuth (server-only — never NEXT_PUBLIC_, never Electron renderer).
# https://console.cloud.google.com/apis/credentials  → OAuth 2.0 Client (Web application)
# CueAI uses NextAuth v5 — do NOT register Appwrite callback URLs for this app.
# Authorized JavaScript origins AND redirect URIs must both be listed:
#   http://127.0.0.1:3000
#   http://localhost:3000
# Redirect URIs (exact NextAuth callbacks — never Appwrite, never cueai://):
#   http://127.0.0.1:3000/api/auth/callback/google     (web + Windows desktop dev)
#   http://localhost:3000/api/auth/callback/google     (browser via localhost)
#   http://127.0.0.1:3002/api/auth/callback/google     (macOS desktop dev)
#   http://127.0.0.1:39100/api/auth/callback/google    (packaged desktop)
#   https://YOUR-DOMAIN/api/auth/callback/google       (production AUTH_URL)
# Desktop returns to the app via cueai://auth/callback after NextAuth finishes.
# AUTH_GOOGLE_SECRET stays on the CueAI server only — never Electron or NEXT_PUBLIC_.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub: https://github.com/settings/developers
# Callback (local): http://localhost:3000/api/auth/callback/github
# Callback (ngrok): https://YOUR-SUBDOMAIN.ngrok-free.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ngrok agent token — https://dashboard.ngrok.com/get-started/your-authtoken
# Used only by `npm run ngrok` / `npm run client-preview` (never expose to the browser).
NGROK_AUTHTOKEN=

# Development/test only. Enabling either flag when CUEAI_ENV=production fails startup.
# NEXT_PUBLIC_SKIP_AUTH=false
# NEXT_PUBLIC_AUTH_BYPASS=false

# Google Gemini / Vertex AI (Desktop Companion live-answer fallback) — server-only, never NEXT_PUBLIC_
# Production Docker path: Next /api/live/answer → FastAPI /v1/live/answer (needs GEMINI_API_KEY on api).
# Local desktop without FastAPI: CUEAI_LIVE_ANSWER_LOCAL=1 uses this web process key.
# If unset, Next still falls back to local Groq/Gemini when FastAPI is unreachable.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# VERTEX_API_KEY=
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-2.5-flash

# Groq (primary for live answers, Resume Tailor, transcription) — server-only
# Gemini is used only when Groq is missing or returns a retryable error.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# Optional extra providers (admin catalog connection tests / live use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional override (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional STT model (default: whisper-large-v3-turbo)
# GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Email (optional but required for real invitation delivery) ---
# Admin invites assign membership immediately. Email is a notification to sign in.
# Without a provider configured, membership still works; emailDelivery.ok will be false.
# Prefer Resend:
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM="CueAI <onboarding@resend.dev>"
# Or SMTP:
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CueAI <noreply@example.com>"
# SMTP_SECURE=false

# --- Desktop licensing (server-side only) ---
# Generate keys: node scripts/generate-license-keys.mjs
# Never commit LICENSE_SIGNING_PRIVATE_KEY. Public key may be set in desktop packaging CI.
# LICENSE_SIGNING_PRIVATE_KEY=
# LICENSE_SIGNING_PUBLIC_KEY=
# LICENSE_OFFLINE_GRACE_HOURS=72

# --- Keygate (server-side only — NEVER expose to Electron/React/Vite) ---
# CueAI backend is the intermediary: Desktop → CueAI → Keygate.
# Public SDK routes use license_key in the body; KEYGATE_SERVER_API_KEY / KEYGATE_API_KEY
# are for /admin/* automation only.
# KEYGATE_BASE_URL=https://your-keygate.example.com
# KEYGATE_SERVER_API_KEY=kg_live_...
# KEYGATE_API_KEY=kg_live_...
# KEYGATE_PRODUCT_ID=
# Optional: Keygate Ed25519 public key (hex) for verifying signed license tokens.
# KEYGATE_PUBLIC_KEY=
# Plan ids used when minting Keygate licenses after Stripe payment succeeds:
# KEYGATE_PLAN_ID_PRO=
# KEYGATE_PLAN_ID_TEAM=

# --- Stripe billing (server-side secrets — NEVER NEXT_PUBLIC_ except publishable key) ---
# Use test keys (sk_test_ / pk_test_ / whsec_ from Stripe CLI) until go-live.
# APP_BASE_URL=http://127.0.0.1:3000
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs (Dashboard → Products). Leave empty until created — checkout disabled.
# Canonical names:
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_TEAM_YEARLY=price_...
# Aliases for monthly Price IDs (same values as STRIPE_PRICE_*_MONTHLY):
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_TEAM_PRICE_ID=price_...
# Optional display amounts (cents). Defaults: Pro monthly 500 ($5), Team monthly 1000 ($10).
# Yearly has no default — set these or rely on Stripe Price.unit_amount.
# STRIPE_DISPLAY_PRO_MONTHLY_CENTS=500
# STRIPE_DISPLAY_PRO_YEARLY_CENTS=
# STRIPE_DISPLAY_TEAM_MONTHLY_CENTS=1000
# STRIPE_DISPLAY_TEAM_YEARLY_CENTS=
# TRIAL_DAYS=0

# --- Retention cleanup (optional, off by default) ---
# Destructive cleanup never runs in development unless ALLOW_DEV is set.
# RETENTION_CLEANUP_ENABLED=true
# RETENTION_CLEANUP_ALLOW_DEV=true

# --- Live answers: OpenAI primary, Groq fallback (server-side only) ---
# OPENAI_API_KEY=
# OPENAI_LIVE_MODEL=gpt-6-luna
# OPENAI_LIVE_MODEL_COMPLEX=gpt-6-luna
# OPENAI_MODEL=gpt-6-luna
# Reasoning models only (o-series, GPT-5+, Luna): low | medium | high. "low" gives faster first tokens.
# OPENAI_REASONING_EFFORT=low
# Screen context, summaries and mock interviews try providers in this order (comma list).
# AI_PROVIDER_ORDER=openai,groq,gemini
# Screenshot (image) requests use their own order.
# AI_IMAGE_PROVIDER_ORDER=gemini,openai,groq
# Max time a provider may take before the next one is tried (ms; the last provider keeps its own limit).
# AI_FALLBACK_ATTEMPT_TIMEOUT_MS=20000
# Groq model used when a screenshot falls back to Groq (must accept images).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Knowledge Base / RAG (server-side only — NEVER NEXT_PUBLIC_) ---
# RAG_ENABLED=true
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# For Gemini embeddings instead:
# RAG_EMBEDDING_PROVIDER=gemini
# RAG_EMBEDDING_MODEL=text-embedding-004
# Local embeddings (no cloud key; good for offline/dev semantic RAG):
# RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# OPENAI_API_KEY=  (required when RAG_EMBEDDING_PROVIDER=openai)
# Optional OpenAI-compatible proxy (OpenRouter, Azure, etc.):
# OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_CHUNK_SIZE=700
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=5
# RAG_MAX_CONTEXT_CHUNKS=6
# Cosine similarity floor for Qdrant (tune with test_knowledge fixtures)
# For local MiniLM embeddings, 0.25–0.30 is a typical starting range.
# RAG_SCORE_THRESHOLD=0.26
# RAG_RERANKER_PROVIDER=none
# RAG_MAX_UPLOAD_BYTES=10485760
# Local Qdrant: docker compose up qdrant -d
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=cueai_knowledge
# Optional data dir for stored knowledge files (default: apps/web/.data)
# CUEAI_DATA_DIR=
