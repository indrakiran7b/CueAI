# Copy to .env in this directory. Placeholders only — never commit real secrets.

AUTH_SECRET=
REDIS_URL=redis://redis:6379/0

# Product environment. production|prod refuses placeholder AUTH_SECRET,
# default bootstrap credentials, and NEXT_PUBLIC_* auth bypass flags.
CUEAI_ENV=development

# Local compose only. Production must set this false (or omit it),
# unless BOOTSTRAP_ADMIN_EMAIL + BOOTSTRAP_ADMIN_PASSWORD are a non-default pair.
CUEAI_BOOTSTRAP_ADMIN_ENABLED=true
# Optional overrides for the first admin. Leave empty in development to use
# the documented local pair. Never put real values in tracked files.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Host ports (change if 3000/6379/6333 are already bound)
WEB_PORT=3000
# FastAPI host debug port (loopback only). Used only with COMPOSE_PROFILES=dev.
API_PORT=8001
REDIS_PORT=6379
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Development: publish FastAPI on 127.0.0.1:${API_PORT}. Production-style: leave empty.
COMPOSE_PROFILES=dev

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Production (gitignored .env only — placeholders here, never real secrets)
# ---------------------------------------------------------------------------
# CUEAI_ENV=production
# AUTH_SECRET=<unique secret>
# CUEAI_BOOTSTRAP_ADMIN_ENABLED=false
# Or a deliberately configured custom bootstrap admin (not the local default pair):
# CUEAI_BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=<your-admin@example.com>
# BOOTSTRAP_ADMIN_PASSWORD=<unique password>
# COMPOSE_PROFILES=
# NEXT_PUBLIC_SKIP_AUTH=false
# NEXT_PUBLIC_AUTH_BYPASS=false

# Optional FastAPI Postgres (also start: docker compose --profile postgres up)
# DATABASE_URL=postgresql+asyncpg://cueai:cueai@postgres:5432/cueai
# POSTGRES_PORT=5432
# POSTGRES_DB=cueai
# POSTGRES_USER=cueai
# POSTGRES_PASSWORD=<change-me>

# Qdrant is optional for keyword RAG. Compose starts it so QDRANT_URL is reachable.
QDRANT_COLLECTION=cueai_knowledge
QDRANT_API_KEY=

# Leave empty for infrastructure validation (no LLM calls required).
# GEMINI_API_KEY is required on api + celery-worker for Desktop Companion answers
# and Docker screen analysis. Do not put real keys here. Use the gitignored .env only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=openai

# Live answers (Docker production): Next proxies to cueai-api Python live.
# Optional local/BYOK path only:
# CUEAI_LIVE_ANSWER_LOCAL=1

# Keycloak is not used by cueai-web or cueai-api. Capacitor only:
# docker compose --profile keycloak up
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=<change-me>
