# CueAI remote client configuration
# Save this file as workspace-data/.env inside the client's app data folder.
#
# Windows app data (replace YOUR_USER):
#   C:\Users\YOUR_USER\AppData\Roaming\cueai-desktop\workspace-data\.env
#
# Or place next to the portable exe and use scripts/launch-client-desktop.ps1
# which sets these vars automatically.
#
# Get CUEAI_WEB_URL from your CueAI admin.

CUEAI_WEB_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Do NOT put Keygate server secrets here.
# KEYGATE_BASE_URL / KEYGATE_SERVER_API_KEY / KEYGATE_API_KEY belong only on the CueAI backend host.
