# Copy to .env in this directory for local development (never commit .env).

CUEAI_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis (required — matches docker-compose redis service)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (optional — migration deferred; omit to skip DB startup and health check)
# DATABASE_URL=postgresql+asyncpg://cueai:cueai@localhost:5432/cueai
