# Copy to .env.local and fill in values
# Never commit real secrets.

AUTH_SECRET=generate-with-openssl-rand-base64-32

# Optional: proxy /api/auth/*, /api/workspaces, /api/onboarding to FastAPI (apps/api).
# CUEAI_USE_FASTAPI=1
# CUEAI_API_URL=http://127.0.0.1:8000
# Local default — keep for day-to-day development
AUTH_URL=http://localhost:3000

# Optional public URL when sharing via ngrok (update whenever the tunnel URL changes):
# NEXT_PUBLIC_APP_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# AUTH_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# NGROK_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
# Redirect URI (ngrok): https://YOUR-SUBDOMAIN.ngrok-free.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub: https://github.com/settings/developers
# Callback (local): http://localhost:3000/api/auth/callback/github
# Callback (ngrok): https://YOUR-SUBDOMAIN.ngrok-free.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ngrok agent token — https://dashboard.ngrok.com/get-started/your-authtoken
# Used only by `npm run ngrok` / `npm run client-preview` (never expose to the browser).
NGROK_AUTHTOKEN=

# Full auth bypass. Default is ON for test builds — no login wall, guest session.
# Set to false to require sign-in again.
# NEXT_PUBLIC_SKIP_AUTH=false

# Credential bypass. Default is ON for test builds: Sign in enters the workspace and
# Create my account runs onboarding, both without checking a password.
# Set to false once the real auth stack is wired up.
# NEXT_PUBLIC_AUTH_BYPASS=false

# Google Gemini / Vertex AI (live overlay answers) — server-only, never NEXT_PUBLIC_
# Default backend is Vertex so usage can bill a GCP project's free credits.
# Create an API key on that GCP project (APIs & Services → Credentials),
# enable Vertex AI, and put the key here (or VERTEX_API_KEY).
# https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=
# VERTEX_API_KEY=
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_BACKEND=vertex
# GEMINI_MODEL=gemini-2.5-flash

# Groq (primary: live answers, Resume Tailor, transcription) — server-only
# Gemini is the fallback when Groq is missing or fails.
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional extra providers (admin catalog connection tests / live use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional override (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional STT model (default: whisper-large-v3-turbo)
# GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Email (optional but required for real invitation delivery) ---
# Admin invites assign membership immediately. Email is a notification to sign in.
# Without a provider configured, membership still works; emailDelivery.ok will be false.
# Prefer Resend:
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM="CueAI <onboarding@resend.dev>"
# Or SMTP:
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CueAI <noreply@example.com>"
# SMTP_SECURE=false

# --- Desktop licensing (server-side only) ---
# Generate keys: node scripts/generate-license-keys.mjs
# Never commit LICENSE_SIGNING_PRIVATE_KEY. Public key may be set in desktop packaging CI.
# LICENSE_SIGNING_PRIVATE_KEY=
# LICENSE_SIGNING_PUBLIC_KEY=
# LICENSE_OFFLINE_GRACE_HOURS=72
# LICENSE_ENFORCEMENT=true

# --- Keygate (server-side only — NEVER expose to Electron/React/Vite) ---
# CueAI backend is the intermediary: Desktop → CueAI → Keygate.
# Public SDK routes use license_key in the body; KEYGATE_SERVER_API_KEY / KEYGATE_API_KEY
# are for /admin/* automation only.
# KEYGATE_BASE_URL=https://your-keygate.example.com
# KEYGATE_SERVER_API_KEY=kg_live_...
# KEYGATE_API_KEY=kg_live_...
# KEYGATE_PRODUCT_ID=
# Optional: Keygate Ed25519 public key (hex) for verifying signed license tokens.
# KEYGATE_PUBLIC_KEY=
# Plan ids used when minting Keygate licenses after Stripe payment succeeds:
# KEYGATE_PLAN_ID_PRO=
# KEYGATE_PLAN_ID_TEAM=

# --- Stripe billing (server-side secrets — NEVER NEXT_PUBLIC_ except publishable key) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs (Dashboard → Products). Leave empty until created — checkout disabled.
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_TEAM_YEARLY=price_...
# Optional display amounts (cents). Defaults: Pro monthly 500 ($5), Team monthly 1000 ($10).
# Yearly has no default — set these or rely on Stripe Price.unit_amount.
# STRIPE_DISPLAY_PRO_MONTHLY_CENTS=500
# STRIPE_DISPLAY_PRO_YEARLY_CENTS=
# STRIPE_DISPLAY_TEAM_MONTHLY_CENTS=1000
# STRIPE_DISPLAY_TEAM_YEARLY_CENTS=
# TRIAL_DAYS=0

# --- Retention cleanup (optional, off by default) ---
# Destructive cleanup never runs in development unless ALLOW_DEV is set.
# RETENTION_CLEANUP_ENABLED=true
# RETENTION_CLEANUP_ALLOW_DEV=true
