# Root env template (web + tooling). Prefer apps/web/.env.local for Next.js.
# Never commit real secrets.

AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# When using ngrok for client testing, also set:
# NEXT_PUBLIC_APP_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# AUTH_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# NGROK_AUTHTOKEN=your-ngrok-authtoken

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stripe (prefer apps/web/.env.local)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_TEAM_MONTHLY=
# STRIPE_PRICE_TEAM_YEARLY=
# TRIAL_DAYS=0

# Keygate (server only)
# KEYGATE_BASE_URL=
# KEYGATE_API_KEY=
# LICENSE_ENFORCEMENT=false

# Knowledge Base / RAG (prefer apps/web/.env.local; server-only)
# RAG_ENABLED=true
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=cueai_knowledge
