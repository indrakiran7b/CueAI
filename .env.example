# Root env template (web + tooling). Prefer apps/web/.env.local for Next.js.
# Never commit real secrets.

AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# When using ngrok for client testing, also set:
# NEXT_PUBLIC_APP_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# AUTH_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# NGROK_AUTHTOKEN=your-ngrok-authtoken

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stripe (prefer repositories/cueai-web/.env.local). Test placeholders only.
# APP_BASE_URL=http://127.0.0.1:3000
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRO_PRICE_ID=
# STRIPE_TEAM_PRICE_ID=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_TEAM_MONTHLY=
